{
  "name": "petcare-ai-veterinary-scribe",
  "version": "1.0.0",
  "description": "AI-Powered Veterinary Live Consultation and Documentation System",
  "scripts": {
    "start": "cd backend && node src/server.js",
    "build": "cd backend && npm install",
    "migrate": "cd backend && node src/db/migrate.js",
    "backend:start": "cd backend && node src/server.js",
    "backend:dev": "cd backend && node --watch src/server.js",
    "backend:test": "cd backend && node --test tests/**/*.test.js",
    "backend:migrate": "cd backend && node src/db/migrate.js",
    "frontend:dev": "cd frontend && npm run dev",
    "frontend:build": "cd frontend && npm run build",
    "test": "cd backend && npm test",
    "test:live": "cd frontend && npx playwright test e2e/live-audio-consultation.spec.js --headed"
  },
  "keywords": [
    "veterinary",
    "ai",
    "scribe",
    "openai",
    "speech-to-text",
    "react",
    "nodejs"
  ],
  "dependencies": {
    "@neon/config": "^1.14.6",
    "@neon/env": "^2.1.9"
  }
}
